{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/claim-guard.js\"",
            "timeout": 15,
            "statusMessage": "Checking file locks..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__bdd095c7-24f7-42cc-8543-0569f5294a0f__graphql_query",
      "mcp__github__pull_request_read",
      "Bash(git fetch *)",
      "mcp__github__get_job_logs",
      "Bash(npm run smoke:introjava)",
      "Bash(npm run smoke:encoding)"
    ]
  }
}
