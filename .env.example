PORT=4000
JWT_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-STRING-IN-PRODUCTION
DB_PATH=./progress.db

# Admin API key. Gates every /api/admin/* route AND the /admin/dashboard page's
# data fetches. Must be at least 20 chars or the admin API fails closed (503).
# Send it as the x-admin-key header. There is no ?key= querystring fallback: a
# key on the URL lands in server logs and browser history. Browsers sign in at
# /admin/login, which exchanges the key for an httpOnly session cookie.
ADMIN_KEY=

# Shopify orders/paid webhook signing secret (Shopify admin: the webhook's
# signing secret). Required for the /api/shopify/webhook/orders-paid route to
# verify HMAC. Without it, that route fails closed and rejects every request.
SHOPIFY_WEBHOOK_SECRET=

# Optional JSON override for the SKU-to-course map. Merged over the defaults in
# config/shopify-skus.js (env wins on shared keys). Example:
# SHOPIFY_SKU_MAP={"CSA-FULL-2025":"ap-csa","CYBER-FULL":"ap-cybersecurity"}
SHOPIFY_SKU_MAP=

# Judge0 (RapidAPI) key for the code-runner proxy. Without it, /api/judge0/*
# and student code grading fail closed with a 500 instead of silently passing.
RAPIDAPI_KEY=

# Resend API key for outbound email (teacher password resets, invites). Unset
# means log-only: the app still works and prints the message instead of sending.
RESEND_API_KEY=

# This service's own origin, used for server-to-server calls it makes back to
# itself (code grading). Defaults to http://127.0.0.1:$PORT when unset.
SELF_BASE_URL=https://progress.apcsexamprep.com

# Public origin used to build links that land in a browser (password reset
# emails). Wins over SELF_BASE_URL; set it when the two differ.
PUBLIC_BASE_URL=https://progress.apcsexamprep.com

# Salt for hashing player IPs in the game leaderboard, so raw IPs are never
# stored. Falls back to JWT_SECRET when unset; set a distinct value in prod.
IP_HASH_SALT=

# Command center (progress.apcsexamprep.com/admin/command). Agent credential for
# /api/command/* and /api/todo/*: sent as "Authorization: Bearer <TODO_KEY>".
# Must be at least 20 chars or the bearer path rejects every request (the
# browser path keeps working through the admin session cookie). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TODO_KEY=

# Scope of TODO_KEY. Anything other than "full" means task data only: promise
# rows, and the person/email on any digest field, are 403 for that credential.
# Leave unset. A content agent dispatched to fix a lab does not need the
# customer list, and if the key leaks the blast radius should be task titles.
TODO_KEY_SCOPE=

# Optional: an email address whose teacher JWT, presented in an apcse_teacher_token
# cookie, is accepted as the command center owner in addition to the admin
# session cookie. Unset means the admin session cookie is the only browser path.
COMMAND_OWNER_EMAIL=

# PostHog product analytics. UNSET MEANS OFF: with no key the server never builds
# a client, /posthog-init.js serves an inert stub, and nothing leaves the box.
# This is the PUBLIC project key (phc_...), which is write-only by design and is
# embedded in the admin pages' JavaScript. Never put a personal (phx_) or secret
# (phs_) key here. Find it in PostHog under Settings > Project > Project API key.
POSTHOG_API_KEY=

# Ingestion host for your region. US is the default; EU projects use
# https://eu.i.posthog.com. Self-hosted instances use their own origin.
POSTHOG_HOST=https://us.i.posthog.com

# Optional. Origin serving the browser bundle. Derived from POSTHOG_HOST when
# unset (us-assets / eu-assets), so only set this for a self-hosted instance that
# splits ingestion from static assets.
POSTHOG_ASSETS_HOST=

# Set to 0 to stop capturing one api_request event per /api/* call while keeping
# the SDK on for explicit domain events. That firehose is the main driver of
# PostHog event volume and therefore of the bill. Any other value leaves it on.
POSTHOG_CAPTURE_REQUESTS=

# Ad gate for students, read by GET /api/student/entitlement (task #80). UNSET
# MEANS OFF: the endpoint answers with an empty ad policy (teacherTier null,
# unitsUnlocked {}), so the site-wide theme script suppresses nothing and ads
# behave exactly as they did before the route existed. Set to "on" to turn on
# ad-free browsing for students whose teacher holds a live entitlement for their
# course (whole course unlocked, plus the unit-1 preview the script gives any
# enrolled student). Read once at boot, so changing it needs a restart.
# The honest facts (course, enrolled, entitled) are returned either way.
STUDENT_AD_GATE=

# ── SITE ASSISTANT (Phase 0: problem reports, no model) ──────────────────────
# Where an escalation email goes. Falls back to COMMAND_OWNER_EMAIL. With
# neither set, reports are still stored and still filed on the board; only the
# mail is skipped. Mail itself needs RESEND_API_KEY above.
ASSISTANT_ALERT_EMAIL=

# Per-IP brake on POST /api/assistant/report. Defaults are 5 reports per
# 15 minutes, which is what ships. Tunable because the right ceiling is not
# knowable before the endpoint sees real traffic.
ASSISTANT_REPORT_MAX_PER_WINDOW=
ASSISTANT_REPORT_WINDOW_MS=
